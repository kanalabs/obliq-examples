# ---- Solana cluster the transaction lands on -------------------------------
# local validator:  http://127.0.0.1:8899
# devnet:           https://api.devnet.solana.com
# mainnet:          your paid RPC (Helius / Triton / QuickNode / ...)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- The Obliq paymaster (the fee payer) -----------------------------------
# Data-plane JSON-RPC endpoint and the control-plane base (same host locally).
OBLIQ_RPC_URL=https://solana-paymaster-mainnet.kanalabs.io/rpc
OBLIQ_CONTROL_URL=https://solana-paymaster-mainnet.kanalabs.io

# Your tenant's Bearer API key. Leave blank and run `npm run register` to mint one.
OBLIQ_API_KEY=

# ---- The end user (who pays 0 SOL) -----------------------------------------
# base58 secret key of the end-user wallet. Leave blank on local/devnet to have
# the example generate a throwaway user and airdrop it the transfer amount.
USER_WALLET_SECRET_KEY=

# base58 pubkey that receives the SOL. Leave blank for a random throwaway address.
RECIPIENT=

# How much SOL to transfer (the user spends only this; Obliq pays the fee).
AMOUNT_SOL=0.001
