# ---- Solana cluster --------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Obliq paymaster -------------------------------------------------------
OBLIQ_RPC_URL=https://solana-paymaster-mainnet.kanalabs.io/rpc
OBLIQ_CONTROL_URL=https://solana-paymaster-mainnet.kanalabs.io
OBLIQ_API_KEY=
# Captured automatically by `npm run register` (needed to update tenant config).
OBLIQ_TENANT_ID=

# ---- USDC mint -------------------------------------------------------------
# local:   leave blank — `npm run setup` creates a 6-decimal test mint for you
# devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   (Circle devnet USDC)
# mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   (USDC)
USDC_MINT=

# ---- Wallets ---------------------------------------------------------------
# base58 user secret key; blank on local/devnet = throwaway + airdrop + mint test USDC
USER_WALLET_SECRET_KEY=
# base58 recipient pubkey; blank = throwaway
RECIPIENT=

# Amount of USDC to send (human units; 6 decimals under the hood).
AMOUNT_USDC=1.0
