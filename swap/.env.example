# ---- Solana cluster --------------------------------------------------------
# Jupiter has liquidity on MAINNET only. `quote` works anywhere (read-only);
# `swap` requires mainnet + a user holding real USDC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Obliq paymaster -------------------------------------------------------
OBLIQ_RPC_URL=https://solana-paymaster-mainnet.kanalabs.io/rpc
OBLIQ_CONTROL_URL=https://solana-paymaster-mainnet.kanalabs.io
OBLIQ_API_KEY=
OBLIQ_TENANT_ID=

# ---- Jupiter Swap API ------------------------------------------------------
# Free tier: https://lite-api.jup.ag   ·   API-key tier: https://api.jup.ag
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# ---- The swap: USDC -> SOL -------------------------------------------------
INPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
OUTPUT_MINT=So11111111111111111111111111111111111111112
AMOUNT_USDC=1.0
SLIPPAGE_BPS=50

# ---- The user (must hold USDC for a real swap) -----------------------------
USER_WALLET_SECRET_KEY=

# Safety: set to "true" to allow `swap` on a non-mainnet RPC (will likely fail —
# no routes). Default keeps you from spending on the wrong cluster.
ALLOW_NON_MAINNET=false
