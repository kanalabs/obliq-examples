# Fill this in once and all three examples use it.
#
# Each example also reads a `.env` in its own directory, which takes precedence —
# use that only to override something for a single example.
#
# Copy to `.env` (note the leading dot; most editors hide it) and never commit it.


# ═══ Required ════════════════════════════════════════════════════════════════

# The credential we issued you. Authenticates YOU to OBLIQ.
# Looks like obliq_prod_<key id>_<secret>.
# Request one: https://xyra-labs.mintlify.site/guides/onboarding/request-access
OBLIQ_API_KEY=

# base58 secret key of a THROWAWAY wallet. This signs the transaction; it never
# leaves your machine and we never see it. NOT the same thing as the API key.
# It needs the token being spent — and no SOL, which is the whole point.
USER_WALLET_SECRET_KEY=


# ═══ Already set for mainnet — change only if you know why ═══════════════════

# USDC on Solana mainnet. `transfer-usdc` refuses to run without it.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# How much each example moves. Start small: these are real funds.
#
# AMOUNT_USDC is shared: it is both the amount `swap` sells AND the amount
# `transfer-usdc` sends. There is no separate variable for the two.
AMOUNT_USDC=0.1

# transfer-sol only.
AMOUNT_SOL=0.001

# Who receives the transfers — any Solana wallet address.
# REQUIRED on mainnet, and the examples refuse to run without it: a blank value
# generates an address nobody holds the key to, so the funds would be gone for
# good. Use a wallet you own. To watch OBLIQ pay account rent, use one that has
# never held the token you are sending.
RECIPIENT=

# Swap slippage tolerance, in basis points. 50 = 0.5%.
SLIPPAGE_BPS=50

# Which pair the swap trades. Defaults to USDC -> SOL, the documented flow.
# INPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# OUTPUT_MINT=So11111111111111111111111111111111111111112


# ═══ Endpoints — defaults are production ═════════════════════════════════════

# OBLIQ_RPC_URL=https://solana-paymaster-mainnet.kanalabs.io/rpc
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter's free tier is the default. A key raises the rate limit.
# JUPITER_BASE_URL=https://api.jup.ag
# JUPITER_API_KEY=


# ═══ Not needed here ═════════════════════════════════════════════════════════
#
# OBLIQ_CONTROL_URL, OBLIQ_TENANT_ID and ALLOW_NON_MAINNET are read only by the
# `register`, `setup` and `fund` commands, which call operator-only endpoints and
# work against a local paymaster, not production. You will not need them.
